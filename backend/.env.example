# Server Port & Environment
PORT=5000
NODE_ENV=production

# Client URL (for CORS and Socket.io allowed origins)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/roomchat?retryWrites=true&w=majority

# JWT Secret Key for Memory Session Verification
JWT_SECRET=ultra_secure_ninja_secret_key_change_me_in_prod_9876543210
JWT_EXPIRES_IN=24h

# 4-Digit Master Salt Key (optional extra security pepper)
PIN_PEPPER=ninja_secret_pepper_2026

# Cloudinary Credentials (for Rich Media: Live Camera, Videos, Audio Voice Notes)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Preconfigured 2-Person Credentials (Auto-seeded if users don't exist)
PARTNER_ONE_USER_ID=alex
PARTNER_ONE_PASS=SecretPass@123
PARTNER_ONE_PIN=1337
PARTNER_ONE_NAME=Alex

PARTNER_TWO_USER_ID=sam
PARTNER_TWO_PASS=SecretPass@456
PARTNER_TWO_PIN=7331
PARTNER_TWO_NAME=Sam

